# ---- Required ----
# OpenAI: document embeddings (always needed) + the chat model when LLM_PROVIDER=openai
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Tavily: web search tool used by the DocumentProcessor agent
# Get one at https://app.tavily.com
TAVILY_API_KEY=

# ---- Optional: only if you switch the chat model provider ----
# Google Gemini (LLM_PROVIDER=google) - https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Groq (LLM_PROVIDER=groq) - https://console.groq.com/keys
GROQ_API_KEY=

# ---- Model selection ----
# openai | google | groq
LLM_PROVIDER=openai
# Leave blank for the default (openai: gpt-4o-mini, google: gemini-2.5-flash, groq: llama-3.3-70b-versatile)
LLM_MODEL=
